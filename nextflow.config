/*
 * rnaseq-flow - main Nextflow configuration
 */

params {
    // Input/Output options
    input                      = null
    counts                     = null // Pre-computed gene count matrix (featureCounts wide or plain gene-id + samples); enters at differential expression, skipping QC/alignment. Requires --input (design) and --gtf (annotation).
    outdir                     = 'results'
    tracedir                   = "${params.outdir}/pipeline_info"
    publish_dir_mode           = 'copy'
    stop_at                    = null // Control pipeline stages: preQC, postQC, DE, GSEA

    // Alignment options
    aligner                    = 'star' // Options: star, hisat2, salmon, kallisto
    strandedness               = 'auto' // Options: auto (infer per-sample from RSeQC; default), unstranded, forward, reverse

    // Reference genomes (user must supply, or generate with the helper workflows)
    fasta                      = null
    gtf                        = null
    transcript_fasta           = null // Optional override for the Salmon/Kallisto build, which otherwise cuts the transcriptome from --genome_fasta and --gtf with gffread. Required at run time by IsoformSwitchAnalyzeR: pass the transcripts.fa.gz published beside the index
    gmt                        = null // Path to GMT file for GSEA
    organism                   = 'hsapiens' // Organism ID for gProfiler (e.g. hsapiens, mmusculus) and GSEA
    read_length                = 100  // Read length for rMATS
    ctat_lib                   = null // Path to CTAT Genome Library directory for STAR-Fusion
    isoform_switch             = false // Run IsoformSwitchAnalyzeR (requires aligner = salmon)
    dtu                        = false // Run DEXSeq differential transcript usage (requires aligner = salmon/kallisto)
    diffsplice                 = false // Run edgeR diffSpliceDGE (exon level: star/hisat2; transcript level: salmon/kallisto)
    design                     = null  // DESeq2/edgeR model formula override, e.g. '~ batch + condition' (default: auto from the samplesheet)
    reference_level            = 'REF' // Baseline condition: the denominator of every contrast, and the level fold changes and PSI differences are measured against

    // Download parameters
    download_refs              = false
    download_species           = 'homo_sapiens'
    download_source            = 'ensembl'
    download_release           = null  // Pin an Ensembl release for reproducibility, e.g. 102 (default: current/latest)
    download_gmt               = false // Download GMT gene sets for the organism

    // Build Indices parameters
    build_indices              = false
    genome_fasta               = null // Required for STAR/HISAT2/Salmon index build
    hisat2_build_memory        = null // Memory needed for a splice-aware HISAT2 index (e.g. '200.GB'). Default: estimated from the GTF size.

    // Predetermined indices (optional, saves time)
    star_index                 = null
    hisat2_index               = null
    salmon_index               = null
    kallisto_index             = null

    // Resource ceilings (applied via check_max)
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Generic
    help                       = false // Print the parameter help (from nextflow_schema.json) and exit
    validate_only              = false // Validate the samplesheet and inputs, then exit without running anything
    // On by default: provenance that has to be remembered is not provenance.
    // A param rather than a profile, because conf/prov.config is included after
    // profiles are merged, so a profile setting prov.enabled would be
    // overwritten, whereas a param read inside that file is not.
    ro_crate                   = true  // Write ro-crate-metadata.json beside the results

    // Attribution for this run (run_by, run_by_orcid, run_contributors) is
    // deliberately NOT declared here. Nextflow merges config files with
    // $HOME/.nextflow/config at the lowest priority, below this file, so a
    // default set here would override whatever someone had recorded once in
    // their own home config, which is where "who am I" belongs. The params are
    // declared in nextflow_schema.json, which is what --help and the typo check
    // read, and resolveContributors() in workflows/rnaseq.nf reads them with
    // params.containsKey() so an absent one is not an error.
}

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    // SGE / Univa Grid Engine execution, tuned for the UCL Research Computing
    // clusters (Myriad / Kathleen / Young). Sets the executor, the per-core
    // memory request format the scheduler expects, node-local scratch and
    // Singularity. Use on its own -- it already enables Singularity, so do not
    // combine it with -profile singularity.
    //   nextflow run main.nf -profile sge --input samplesheet.csv ...
    sge {
        includeConfig 'conf/sge.config'
    }
    // Resource caps for the small S. cerevisiae test dataset, so the pipeline
    // fits a laptop or a memory-limited WSL instance. See examples/yeast/.
    //   nextflow run main.nf -profile test_yeast,docker ...
    test_yeast {
        includeConfig 'conf/test_yeast.config'
    }
    // Lightweight profile for syntax / channel-topology validation.
    // Combine with -stub-run, e.g.  nextflow run main.nf -profile test -stub-run
    //
    // The caps are what make that command work anywhere. A stub task runs
    // `mkdir` and `touch`, but it still carries its label's request, and
    // conf/base.config is sized for mammalian genomes: process_high asks for
    // 48 GB. The local executor refuses outright to schedule a task asking for
    // more memory than the machine has, rather than queueing it, so
    // `-profile test -stub-run` died at STAR_ALIGN on an ordinary laptop and
    // would die the same way on a 7 GB CI runner, after the smaller labels had
    // already published. resourceLimits is set here as well as the params,
    // following conf/test_yeast.config, rather than relying on base.config
    // picking the params up after the profile merge.
    test {
        cleanup                = false
        params.max_cpus        = 2
        params.max_memory      = '4.GB'
        params.max_time        = '1.h'
        process.resourceLimits = [ cpus: 2, memory: 4.GB, time: 1.h ]
    }
}

// Wave: on-the-fly container provisioning. Processes that declare a `conda`
// directive instead of a fixed `container` (e.g. DOWNLOAD_GMT) have a minimal,
// secure image built automatically by the Wave service at run time, so no
// specific pre-built biocontainer has to exist.
wave {
    enabled = true
}

// The baseline condition is deliberately not set here any more.
//
// It used to be an `env` entry. Six scripts need it (deseq2.R, edger.R,
// run_rmats.py, dtu_dexseq.R, diffsplice_edger.R and isoform_switch.R) and
// three of them take a variadic list of count files as their final argument,
// so a new positional parameter would have moved that boundary in each. An env
// entry avoided all of it.
//
// What it also avoided was the task hash, which does not cover the env scope.
// A run that changed --reference_level therefore resumed every analysis task
// from cache and republished the previous baseline's results, while
// run_manifest.json and the RO-Crate recorded the new one. Measured on the
// yeast test data on 2026-10-29: REF and NaCl runs produced byte-identical
// deseq2_output, every file still named *_NaCl_vs_REF, HSP12 at
// log2FoldChange +8.141 in both, and "reference_level": "NaCl" sitting in the
// manifest beside them. Wrong numbers are recoverable; wrong numbers with
// provenance vouching for them are not.
//
// Each of those six processes now takes the level as a `val` input and exports
// the same variable at the top of its script. An input is hashed, so a
// different baseline recomputes, and the value appears in .command.sh, which
// is the file the hash actually covers. No analysis script changed: they all
// still read RNASEQ_FLOW_REFERENCE_LEVEL and still default to 'REF'.

// Base resources for every process + per-process publishDir rules.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
// The Workflow Run RO-Crate, on by default rather than behind a profile.
// Provenance that has to be remembered is not provenance, and a run without it
// cannot be redone later. Turn it off with --ro_crate false.
//
// Note that this disables the crate, not the plugin: the plugins block in
// conf/prov.config is unconditional, so Nextflow still resolves nf-prov on
// every run. An offline environment needs it staged in $NXF_HOME/plugins
// either way. See the TRE section of USAGE.md.
includeConfig 'conf/prov.config'

// Manifest
manifest {
    name            = 'rnaseq-flow'
    // `author` is deprecated from Nextflow 24.10 in favour of `contributors`,
    // but Nextflow's own execution report still reads it, so both are set and
    // must agree. CITATION.cff and .zenodo.json carry the same values.
    author          = 'Nicholas Owen'
    contributors    = [[
        name        : 'Nicholas Owen',
        affiliation : 'University College London',
        orcid       : 'https://orcid.org/0000-0001-5598-6274',
        github      : 'https://github.com/nicholas-owen',
        contribution: ['author', 'maintainer']
    ]]
    homePage        = 'https://github.com/nicholas-owen/rnaseq-flow'
    description     = 'A modular bulk RNA-seq analysis pipeline (DSL2)'
    // SPDX identifier, and the Zenodo concept DOI that resolves to all
    // versions. Both reach run_manifest.json, so a results directory that
    // travels by email states its terms and what to cite.
    license         = 'GPL-3.0-only'
    doi             = '10.5281/zenodo.21880328'
    mainScript      = 'main.nf'
    // The config and scripts use the strict language (process.resourceLimits,
    // the entry-workflow onComplete: section, no top-level statements), which is
    // the default parser from Nextflow 25.10 onwards. Verified on 26.04.
    nextflowVersion = '!>=25.10.0'
    version         = '1.8.0'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline, report and trace.
// The run timestamp is inlined into each filename rather than held in a shared
// `def` variable: Nextflow's strict config parser (default from 25.10 / 26.x)
// forbids variable declarations in a config file. The three calls resolve within
// the same config-load instant, so the timestamps match.
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    // Emit raw numeric values (realtime in ms, memory in bytes, %cpu as a
    // number) so the run-completion summary (workflow.onComplete in main.nf)
    // can aggregate per-process resource usage reliably. The human-readable
    // resource view is the Nextflow execution report and run_summary.html.
    raw     = true
}

// Per-process resource ceilings are enforced natively by
// `process.resourceLimits` in conf/base.config (Nextflow >= 24.04), which caps
// every request at params.max_cpus / max_memory / max_time. This replaced the
// old check_max() helper: Nextflow's strict config parser (default from
// Nextflow 25.10 / 26.x) does not allow function definitions in a config file.
