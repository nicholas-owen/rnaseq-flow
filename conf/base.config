/*
 * conf/base.config
 * ------------------------------------------------------------------
 * Default compute resources for every process, keyed off the process
 * labels (process_single / process_low / process_medium / process_high).
 *
 * Ceilings: process.resourceLimits caps every request at
 * --max_cpus / --max_memory / --max_time (Nextflow's native mechanism,
 * >= 24.04). This replaced the old check_max() helper, which the strict
 * config parser (default from Nextflow 25.10 / 26.x) rejects because it is
 * a function definition inside a config file.
 *
 * Requests are multiplied by task.attempt, so a failed task is retried once
 * with more memory/time; resourceLimits then clamps the retried request too.
 */

process {

    // Cap every per-process request at the configured maxima.
    // MemoryUnit / Duration are referenced unqualified: the language server's
    // type universe knows those names, but not the fully-qualified
    // nextflow.util.* forms, which it reports as undefined.
    resourceLimits = [
        cpus  : (params.max_cpus   as int),
        memory: (params.max_memory as MemoryUnit),
        time  : (params.max_time   as Duration)
    ]

    cpus   = { 1     * task.attempt }
    memory = { 6.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    // Retry once on the exit codes typically associated with out-of-memory
    // or scheduler kills; otherwise stop the run.
    errorStrategy = { task.exitStatus in ((130..145) + [104]) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = -1

    withLabel:process_single {
        cpus   = { 1 }
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // STAR genome indexing of a mammalian genome is memory-hungry.
    withName:STAR_GENOME_GENERATE {
        memory = { 38.GB * task.attempt }
    }

    // A splice-aware HISAT2 index (hisat2-build --ss --exon) is far hungrier
    // still -- of the order of 200 GB for human, because peak memory is driven by
    // the splice graph built from the GTF rather than by the genome. Rather than
    // a flat figure (which would make a small genome reserve a mammalian-sized
    // node), estimate it from the GTF:
    //
    //     8 GB base (genome FM index)  +  45 GB per GB of *uncompressed* GTF
    //
    // anchored on human (~4.34 GB GTF -> ~204 GB, within the HISAT2 authors'
    // 160-200 GB). A gzipped GTF is scaled up by 33x, the compression ratio
    // measured on Ensembl release-116 human/mouse GTFs (the two where the ceiling
    // bites); smaller genomes compress less, so this over-estimates them, which
    // is the safe direction -- a few spare GB, never an OOM. Override the whole
    // calculation with --hisat2_build_memory '200.GB'.
    //
    // The estimate lives once, in ext.build_memory_gb; the memory request derives
    // from it. resourceLimits then caps the request at --max_memory, and when the
    // cap bites HISAT2_BUILD compares task.memory against ext.build_memory_gb and
    // drops --ss/--exon rather than being OOM-killed (see the module).
    //
    // NOTE: this is an inline closure, not a helper function, because the strict
    // config parser forbids function definitions in a config file.
    withName:HISAT2_BUILD {
        // ext carries a plain NUMBER OF GIGABYTES, not a MemoryUnit: the unit is
        // applied once, in the memory directive below. The module reads the same
        // number back to decide whether it can build a splice-aware index, so
        // neither side needs a type conversion.
        ext.build_memory_gb = {
            if (params.hisat2_build_memory) {
                // A user-supplied value such as '200.GB' -> 200.
                Math.max(1L, (params.hisat2_build_memory as MemoryUnit).toGiga())
            } else {
                long bytes = 0
                boolean gz = false
                if (params.gtf) {
                    // Resolves a glob as well as a literal path. The documented
                    // commands pass --gtf refs/<species>/<release>/*.gtf.gz. A
                    // shell normally expands that before Nextflow sees it, but
                    // quoted, or supplied through -params-file, or run from a
                    // shell that leaves an unmatched pattern alone, it arrives
                    // here intact and new File() cannot stat it. bytes then
                    // stayed 0, the estimate fell to the 200 GB mammalian worst
                    // case, resourceLimits clamped that to --max_memory, and the
                    // module responded by dropping --ss/--exon. The result was a
                    // quietly less capable index for a yeast-sized genome (B3).
                    //
                    // java.io and a regex rather than Nextflow's file(), which no
                    // config file here uses, and inline rather than in a helper,
                    // because the strict config parser forbids function
                    // definitions in a config file.
                    def spec   = params.gtf.toString()
                    def direct = new File(spec)
                    def hits   = []
                    if (direct.isFile()) {
                        hits = [ direct ]
                    }
                    else if (spec.contains('*') || spec.contains('?')) {
                        def parent = direct.parentFile ?: new File('.')
                        // Escape the dots first, then turn the wildcards into
                        // character classes, so '*.gtf.gz' becomes
                        // '[^/]*\.gtf\.gz' and not '[^/]*' followed by any byte.
                        def rx = direct.name
                            .replace('.', '\\.')
                            .replace('*', '[^/]*')
                            .replace('?', '[^/]')
                        // An empty list, not `new File[0]`: the strict config
                        // parser rejects Java array construction, and
                        // findAll() is happy with either.
                        hits = (parent.listFiles()?.toList() ?: []).findAll { f ->
                            f.isFile() && f.name ==~ rx
                        }
                    }
                    // The largest match, so a directory holding the annotation
                    // next to a smaller sidecar still sizes the request from the
                    // annotation rather than from the sidecar.
                    def chosen = hits ? hits.max { f -> f.length() } : null
                    if (chosen) {
                        bytes = chosen.length()
                        gz    = chosen.name.endsWith('.gz')
                    }
                }
                if (bytes <= 0) {
                    // No readable GTF at submission time: assume the mammalian
                    // worst case rather than silently under-requesting.
                    200L
                } else {
                    double gtf_gb = bytes / 1073741824d
                    if (gz) gtf_gb = gtf_gb * 33
                    Math.max(8L, Math.ceil(8 + 45 * gtf_gb) as long)
                }
            }
        }
        memory = { task.ext.build_memory_gb * 1.GB * task.attempt }
    }
}
