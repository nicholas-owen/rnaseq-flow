/*
 * conf/sge.config
 * ------------------------------------------------------------------
 * Execution profile for an SGE / Univa Grid Engine cluster, tuned for the
 * UCL Research Computing clusters (Myriad / Kathleen / Young).
 *
 * Derived from the nf-core institutional config for UCL Myriad by
 * Chris Wyatt (ucbtcdr@ucl.ac.uk) and Fernando Duarte (f.frutos@ucl.ac.uk):
 *   https://github.com/nf-core/configs/blob/master/conf/ucl_myriad.config
 * (nf-core/configs is MIT-licensed; this notice preserves that attribution.)
 *
 * Adapted for rnaseq-flow's resource profile by Nicholas Owen
 * (n.owen@ucl.ac.uk) — see "What was changed" below.
 *
 * Usage:
 *   nextflow run main.nf -profile sge --input samplesheet.csv ...
 *
 * The profile only sets the executor, the scheduler request format and the
 * container runtime. Every process's cpus/memory/time still comes from
 * conf/base.config, and is still capped by params.max_* through
 * process.resourceLimits.
 *
 * ------------------------------------------------------------------
 * WHAT WAS CHANGED relative to the upstream nf-core config, and why
 *
 * 1. Memory per core is rounded UP.
 *    Upstream computes `task.memory.mega / task.cpus` directly. Groovy's `/`
 *    on integral types returns a BigDecimal (unlike Java), so any request that
 *    does not divide evenly interpolates a fraction straight into the qsub
 *    argument, e.g. `-l mem=3242.6666666666666666666666667M`, which the
 *    scheduler rejects. nf-core's own labels all divide cleanly at 4 GB/core so
 *    upstream never hits this, but rnaseq-flow's withName overrides do:
 *      STAR_GENOME_GENERATE  38 GB / 12 = 3242.67   -> rejected
 *      HISAT2_BUILD (mouse) 158 GB / 12 = 13482.67  -> rejected
 *    Math.ceil() fixes it. Rounding *up* matters: rounding down under-requests
 *    and invites an OOM kill.
 *
 * 2. params.max_time is set (see below). rnaseq-flow defaults to 240.h, which
 *    Nextflow turns into `-l h_rt=240:00:00` — above the queue limit, so every
 *    job would be rejected at submission.
 *
 * 3. Node-local scratch is requested AND used. Upstream sets `scratch = false`,
 *    which sends all the heavy RNA-seq I/O (BAM sorting, STAR temp files,
 *    featureCounts) to the shared filesystem. Here a tmpfs allocation is
 *    requested per label and `scratch = '$TMPDIR'` actually uses it.
 * ------------------------------------------------------------------
 */

params {
    config_profile_description = 'UCL Myriad / SGE cluster profile for rnaseq-flow'
    config_profile_contact     = 'Nicholas Owen (n.owen@ucl.ac.uk), Chris Wyatt (ucbtcdr@ucl.ac.uk), Fernando Duarte (f.frutos@ucl.ac.uk)'
    config_profile_url         = 'https://www.rc.ucl.ac.uk/docs/Clusters/Myriad/'

    // Ceilings applied by process.resourceLimits (conf/base.config).
    //
    // Sized for a Myriad *standard* (D) compute node. Because memory is
    // requested per slot, what decides where a job can run is not the total but
    // the memory-per-core ratio (total / cpus):
    //
    //   Node    Cores  Usable RAM   Per core   tmpfs   Count
    //   D          36      160 GB     4.4 GB   1500G     342   <- the default target
    //   I, B       36     1483 GB    41.1 GB   1500G      17   high memory
    //   T          64      755 GB    11.7 GB    420G       6
    //
    // Every process in this pipeline requests <= 4 GB/core (process_high is
    // 48 GB over 12 cores = 4 GB/core), so the whole workflow fits the 342
    // standard nodes. The one exception is mammalian HISAT2 index building --
    // see the note below.
    //
    // Verify against https://www.rc.ucl.ac.uk/docs/Clusters/Myriad/ and your own
    // entitlement: a request above a node's usable RAM, or above the queue
    // wall-clock maximum, is rejected at submission rather than queued.
    //
    // NOTE -- HISAT2 index building is deliberately NOT bound by this ceiling.
    // A splice-aware HISAT2 index (hisat2-build --ss --exon) needs ~204 GB for
    // human and ~158 GB for mouse (the estimate scales with the GTF; see
    // conf/base.config). Over 12 cores that is 17 and 13.2 GB/core, so both
    // require a high-memory (I/B) node -- they cannot run on a D node whatever
    // the total. Clamping them to 160 GB would make HISAT2_BUILD silently drop
    // --ss/--exon and build a *non*-splice-aware index, so that process is given
    // its own, higher resourceLimits further down and the -ac allow=IB rule in
    // clusterOptions sends it to an I/B node. Human, mouse, zebrafish and yeast
    // therefore all build splice-aware with no extra flags. See USAGE.md,
    // "Building a HISAT2 index under -profile sge".
    max_cpus   = 36
    max_memory = 160.GB

    // Wall-clock limits are set by CORE COUNT, not node type:
    //   1 core                    72 h
    //   2-36 cores                48 h
    //   2-48 cores (UV nodes)     48 h
    //   2-64 cores (T nodes)      48 h
    //
    // 48 h is therefore the only safe global ceiling -- a multi-core job asking
    // for more is rejected at submission, and every process here except
    // process_single/MULTIQC is multi-core. Setting it is REQUIRED: the
    // pipeline's own 240.h default becomes `-l h_rt=240:00:00` and would have
    // every job refused.
    //
    // Nothing in this pipeline comes close to the limit -- the longest request
    // is process_high at 16 h, or 32 h after its one retry -- so the extra 24 h
    // available to single-core jobs is not worth a per-label rule. Do not raise
    // this above 48 h unless the job is genuinely single-core.
    max_time   = 48.h
}

executor {
    name            = 'sge'
    queueSize       = 100        // concurrent jobs held in the scheduler
    submitRateLimit = '10/1s'    // ease pressure on the qmaster
}

process {
    // Parallel environment for multi-slot jobs. Nextflow emits `-pe smp <cpus>`.
    penv = 'smp'

    // Node-local scratch requested per label via `-l tmpfs=` below. Myriad
    // nodes carry plenty of it (1500G on D and I/B, 420G on T), so these are
    // conservative starting points for bulk RNA-seq rather than a hard limit --
    // raise process_high freely if you sort very large BAMs, since a full tmpfs
    // fails the job with a disk-full error.
    ext.tmpfs = '10G'

    withLabel:process_single { ext.tmpfs = '10G' }
    withLabel:process_low    { ext.tmpfs = '10G' }
    withLabel:process_medium { ext.tmpfs = '20G' }
    withLabel:process_high   { ext.tmpfs = '50G' }

    // Index building writes large temporary structures.
    withName:STAR_GENOME_GENERATE { ext.tmpfs = '50G' }

    // HISAT2_BUILD is exempted from the standard-node memory ceiling so that a
    // mammalian splice-aware index works out of the box.
    //
    // The global resourceLimits above is sized to a D node (160 GB), but a
    // splice-aware human index needs ~204 GB. Left clamped, the module would
    // drop --ss/--exon and quietly build a *non*-splice-aware index. Raising the
    // global ceiling instead would let every process request that much, pushing
    // unrelated jobs toward the high-memory queue, so the exemption is scoped to
    // this one process: its GTF-derived estimate passes through unclamped, and
    // the per-core rule in clusterOptions then routes it to an I/B node
    // (17.0 GB/core for human, 13.2 for mouse -- both well inside I/B's 41.1).
    //
    // 1483 GB is the I/B usable maximum. cpus/time still match the global
    // ceiling: I/B nodes have 36 cores, and the 48 h wall-clock limit applies to
    // any multi-core job regardless of node type.
    //
    // NOTE for other sites: if your account cannot land on high-memory nodes,
    // lower this to your largest node's usable RAM. The job would otherwise
    // queue against nothing, whereas the clamped behaviour at least produces a
    // usable (if non-splice-aware) index.
    withName:HISAT2_BUILD {
        ext.tmpfs      = '50G'
        resourceLimits = [ cpus: 36, memory: 1483.GB, time: 48.h ]
    }

    clusterOptions = {
        // UCL clusters request memory PER CORE; the scheduler multiplies by the
        // number of slots (-pe smp N) to get the job total. Round up, both to
        // avoid under-requesting and because a fractional value is not a valid
        // qsub argument (see note 1 in the header).
        def mem_per_cpu = Math.ceil(task.memory.mega / task.cpus) as long
        def opts = "-S /bin/bash -l mem=${mem_per_cpu}M -l tmpfs=${task.ext.tmpfs ?: '10G'}"

        // A standard (D) node provides 4.4 GB/core. A job asking for more than
        // that cannot run on one whatever its total, so ask explicitly for the
        // high-memory nodes (I/B, 41.1 GB/core) with Myriad's node-type
        // selector. Without this the job would sit in the queue matching
        // nothing. In practice only mammalian HISAT2 index building crosses the
        // threshold -- 17.0 GB/core for human, 13.2 for mouse -- while every
        // other process in the pipeline sits at <= 4 GB/core and stays on the
        // 342 standard nodes.
        //
        // 4505 MB = 4.4 GB. The T nodes (11.7 GB/core, 6 of them) would also
        // serve requests in the 4.4-11.7 band; nothing here lands in it, so
        // they are left out rather than complicating the rule. To widen it,
        // use `allow=IBT`.
        if (mem_per_cpu > 4505) {
            opts += ' -ac allow=IB'
        }
        opts
    }

    // Run each task on the node's local disk (backed by the tmpfs requested
    // above) instead of the shared filesystem; Nextflow stages inputs in and
    // copies published outputs back automatically.
    scratch = '$TMPDIR'

    // Give Apptainer/Singularity a temp directory on Scratch. The default is
    // the node's /tmp, which is small and can fail image extraction.
    beforeScript = 'mkdir -p $HOME/Scratch/.apptainer/tmp && export SINGULARITY_TMPDIR=$HOME/Scratch/.apptainer/tmp'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/Scratch/.apptainer/pull"
    runOptions = "-B ${System.getenv('HOME')} --no-mount /scratch --writable-tmpfs"
}

// Wave builds images on the fly for the Conda-declared processes (DESEQ2, DTU,
// DIFFSPLICE, QUARTO_REPORT, DOWNLOAD_GMT). It needs outbound HTTPS from the
// submit host. If your cluster blocks that, pre-build those images and pin them
// with `container` directives instead of disabling this.
wave {
    enabled = true
}
