/*
 * Workflow Run RO-Crate output, via the nf-prov plugin.
 *
 * Opt-in, with `-profile prov`, because it downloads a plugin on first use and
 * most runs do not need a crate.
 *
 * 1.7.0 is the series matching this pipeline's nextflowVersion floor of 25.10.
 * 1.8.x requires Nextflow 26.10, which would raise the pipeline's own floor for
 * the sake of an optional output.
 *
 * Deliberately minimal. The plugin's wrroc format accepts one `agent`, one
 * `organization`, a `license` and a `publisher`, which cannot express several
 * contributors, CRediT roles, a project, a funder or a rights holder. Rather
 * than fill in the one slot here and the rest somewhere else, all of it comes
 * from pipeline_info/run_manifest.json via lib/CrateEnricher.groovy, which also
 * adds the sha256, contentSize and dateModified that nf-prov records for
 * nothing. One source of truth, no values to drift apart.
 *
 * That runs in a JVM shutdown hook registered by main.nf, because the plugin
 * writes the crate about 1.6 s after the pipeline's last hook returns.
 */
plugins {
    id 'nf-prov@1.7.0'
}

prov {
    // --ro_crate false turns the crate off. The plugin is still declared, so an
    // environment with no outbound network needs it staged in $NXF_HOME/plugins
    // either way; see the TRE section of USAGE.md.
    // Compared as a string: `--ro_crate false` arrives as the String "false",
    // which is truthy in Groovy.
    enabled = params.ro_crate.toString() != 'false'
    formats {
        wrroc {
            file      = "${params.outdir}/ro-crate-metadata.json"
            overwrite = true
            // Required: without it the plugin warns that the crate is invalid.
            // It has to be stated here rather than read from `manifest.license`
            // because this file is included from the profiles block, which is
            // parsed before the manifest scope is set. enrich_crate.py rewrites
            // it from the run manifest afterwards, so the authoritative value
            // is still the manifest's; keep the two the same anyway.
            license   = 'https://spdx.org/licenses/GPL-3.0-only'
        }
    }
}
