/*
 * conf/slurm.config
 * ------------------------------------------------------------------
 * Execution profile for a Slurm cluster.
 *
 * Usage:
 *   nextflow run main.nf -profile slurm --input samplesheet.csv ...
 *
 * Unlike conf/sge.config, which is tuned to one named cluster, this profile is
 * written to work anywhere Slurm runs and to be pointed at a site with four
 * parameters: --slurm_partition, --slurm_account, --slurm_qos and
 * --slurm_bigmem_partition. With none of them set it submits to the cluster's
 * default partition with no account, which is right on a single-partition
 * cluster and wrong on most shared ones, so set at least the partition.
 *
 * Like the SGE profile, this one sets the executor, the scheduler request
 * format and the container runtime. Every process's cpus/memory/time still
 * comes from conf/base.config, capped by params.max_* through
 * process.resourceLimits.
 *
 * ------------------------------------------------------------------
 * WHAT IS DIFFERENT FROM THE SGE PROFILE
 *
 * 1. Memory is requested as a job total, not per core.
 *    Slurm's --mem is the memory for the whole allocation, which is what
 *    Nextflow emits from `process.memory`. The per-core division that
 *    conf/sge.config has to do by hand, and round up to avoid a fractional
 *    qsub argument, does not arise here.
 *
 *    If your site enforces MaxMemPerCPU, Slurm will reject or silently raise a
 *    request whose memory/cpus ratio is above the limit. The fix is to ask for
 *    more cores or less memory in conf/base.config, not to switch to
 *    --mem-per-cpu: Slurm refuses --mem and --mem-per-cpu together, and
 *    Nextflow always emits --mem when a process declares memory.
 *
 * 2. Large memory is a partition, not a node-class selector.
 *    Where SGE takes `-ac allow=IB`, Slurm takes a different --partition. Only
 *    HISAT2_BUILD needs one (see below), so it is the only process given one.
 *
 * 3. Scratch is `true` rather than `$TMPDIR`.
 *    Not every site defines TMPDIR per job. `scratch = true` makes Nextflow
 *    use the node's temp directory when there is one and fall back sensibly
 *    when there is not. Sites that schedule on local disk can add a request
 *    with --slurm_tmp.
 *
 * 4. --time still has to be capped, for the same reason as SGE.
 *    The pipeline's own default is 240.h, which becomes `--time=240:00:00` and
 *    is above almost every partition's MaxTime, so every job would be rejected
 *    at submission rather than queued.
 * ------------------------------------------------------------------
 */

params {
    config_profile_description = 'Generic Slurm cluster profile for rnaseq-flow'
    config_profile_contact     = 'Nicholas Owen (n.owen@ucl.ac.uk)'
    config_profile_url         = 'https://slurm.schedmd.com/sbatch.html'

    // ---- site settings -------------------------------------------------
    // All optional, all null by default: an unset one is simply not emitted,
    // so the profile submits with the cluster's own defaults.
    //
    //   nextflow run main.nf -profile slurm \
    //       --slurm_partition compute --slurm_account my-project ...

    slurm_partition        = null   // --partition for every process
    slurm_bigmem_partition = null   // --partition for HISAT2_BUILD only
    slurm_account          = null   // --account, where the site bills by project
    slurm_qos              = null   // --qos
    slurm_tmp              = null   // e.g. '50G' -> --tmp=50G, minimum local disk

    // Ceiling for HISAT2_BUILD alone, which is exempt from max_memory below.
    // A splice-aware human index needs about 204 GB, mouse about 158 GB.
    slurm_bigmem_memory    = '256.GB'

    // ---- resource ceilings ----------------------------------------------
    // Applied by process.resourceLimits in conf/base.config. These are
    // deliberately modest so that a first run submits successfully on an
    // ordinary partition; raise them to your node size once you know it.
    //
    // The pipeline's largest ordinary request is process_high: 12 cores,
    // 48 GB, 16 h, doubling to 32 h on its one retry. A 24 h cap therefore
    // clamps that retry rather than failing it. If your partition's MaxTime is
    // lower than 24 h, lower this too, or a retried process_high job is
    // rejected at submission.
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '24.h'
}

executor {
    name            = 'slurm'
    queueSize       = 100        // concurrent jobs held in the scheduler
    submitRateLimit = '10/1s'    // ease pressure on slurmctld

    // Slurm writes the exit code to the shared filesystem, which can lag on a
    // busy cluster. Without this, a finished task whose .exitcode has not
    // appeared yet is read as failed.
    exitReadTimeout = '10 min'
}

process {
    // Unset partition means "the cluster default", which is what Slurm does
    // when --partition is absent.
    queue = params.slurm_partition ?: null

    clusterOptions = {
        // Nextflow already emits --cpus-per-task, --mem and --time from the
        // process directives, so only the site-specific flags belong here.
        def opts = []
        if (params.slurm_account) opts << "--account=${params.slurm_account}"
        if (params.slurm_qos)     opts << "--qos=${params.slurm_qos}"
        if (params.slurm_tmp)     opts << "--tmp=${params.slurm_tmp}"
        opts.join(' ')
    }

    // Run each task on node-local storage rather than the shared filesystem,
    // which is what BAM sorting and STAR's temporary files want. Nextflow
    // stages inputs in and copies published outputs back.
    scratch = true

    // HISAT2_BUILD is exempt from the global memory ceiling, for the same
    // reason it is under SGE: a splice-aware index (hisat2-build --ss --exon)
    // needs roughly 204 GB for human, and the module quietly drops --ss/--exon
    // and builds a non-splice-aware index if it is given less than its
    // estimate. Clamping it to max_memory would therefore not fail, it would
    // produce a worse index with only a warning in the log.
    //
    // Raising the global ceiling instead would let every process ask for that
    // much, so the exemption is scoped here and paired with a partition that
    // can satisfy it.
    //
    // If your site has no large-memory partition, leave
    // --slurm_bigmem_partition unset and lower --slurm_bigmem_memory to your
    // largest node: the build then clamps and warns, which is better than
    // queueing against nothing.
    withName:HISAT2_BUILD {
        queue          = params.slurm_bigmem_partition ?: params.slurm_partition ?: null
        resourceLimits = [
            cpus  : (params.max_cpus as int),
            memory: (params.slurm_bigmem_memory as MemoryUnit),
            time  : (params.max_time as Duration)
        ]
    }

    // Give Apptainer/Singularity a writable temp directory. The default is the
    // node's /tmp, which on many compute nodes is small enough to fail image
    // extraction.
    beforeScript = 'export SINGULARITY_TMPDIR="${SINGULARITY_TMPDIR:-${TMPDIR:-/tmp}}"'
}

singularity {
    enabled    = true
    autoMounts = true
    // NXF_SINGULARITY_CACHEDIR is the variable most sites already set, and
    // sharing one cache across users and runs avoids pulling the same image
    // repeatedly. The fallback is per-user.
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.singularity/cache"
}

// Wave builds images on the fly for the Conda-declared processes (DESEQ2, DTU,
// DIFFSPLICE, ISOFORM_SWITCH, GSEA, GPROFILER, QUARTO_REPORT, DOWNLOAD_GMT). It
// needs outbound HTTPS from the submit host. If your cluster blocks that, use
// the offline bundle with -profile tre,slurm rather than disabling this.
wave {
    enabled = true
}
