/*
 * conf/test_yeast.config
 * ------------------------------------------------------------------
 * Resource caps for running the S. cerevisiae test set on a workstation,
 * laptop or memory-limited WSL instance.
 *
 *   nextflow run main.nf -profile docker -c conf/test_yeast.config ...
 *
 * conf/base.config is sized for mammalian genomes: process_high asks for
 * 48 GB and STAR_GENOME_GENERATE for 38 GB. Those requests exceed a typical
 * developer machine, and the local executor refuses to schedule a task it
 * cannot satisfy ("Process requirement exceeds available memory"). The caps
 * below are applied by process.resourceLimits, which clamps every request.
 *
 * Yeast genuinely needs far less: the 12 Mb genome indexes in about 2 GB with
 * STAR, and the HISAT2 splice-aware estimate comes out at ~9 GB.
 *
 * Raise these to whatever the machine actually has -- they are a ceiling, not
 * a reservation.
 */

params {
    max_cpus   = 4
    max_memory = 12.GB
    max_time   = 4.h

    organism   = 'scerevisiae'   // gProfiler / MSigDB id for S. cerevisiae
}

// resourceLimits is restated here, not just left to conf/base.config, because
// base.config builds it from params.max_* AT PARSE TIME. A file passed with
// `-c` is merged *after* nextflow.config and its includes, so it can change
// params.max_memory without changing the resourceLimits already computed from
// the old value -- the caps would silently have no effect. (Profiles do not
// have this problem: the profiles block is evaluated before base.config is
// included, which is why conf/sge.config works with only a params block. CLI
// --max_memory is also fine, as those are injected before config parsing.)
//
// Setting it explicitly here makes this file work either way -- as
// `-profile test_yeast` or as `-c conf/test_yeast.config`.
process {
    resourceLimits = [
        cpus  : (params.max_cpus   as int),
        memory: (params.max_memory as MemoryUnit),
        time  : (params.max_time   as Duration)
    ]
}
