/*
 * UCL Myriad (SGE). Adapted from nf-core/configs conf/ucl_myriad.config.
 * Vendored deliberately rather than includeConfig'd from a URL: avoids a
 * network fetch at config-parse time and pins the content to this repo.
 */

executor {
    name            = 'sge'
    queueSize       = 100
    submitRateLimit = '10/1s'
}

process {
    penv           = 'smp'
    clusterOptions = {
        // Myriad allocates memory per slot, not per job
        def memoryPerCpu = task.memory.mega / task.cpus
        return "-S /bin/bash -l mem=${memoryPerCpu}M "
    }
    scratch = false
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/Scratch/.apptainer/pull"
    runOptions = "-B ${System.getenv('HOME')},${System.getenv('PWD')} --no-mount /scratch --writable-tmpfs"
}
